# PUBLIC TEMPLATE ONLY. Replace these placeholders in your server's private
# configuration. Neither the original Worker nor tools/local-preview.mjs
# automatically loads .env files.
#
# At least one owner allowlist value is required for production editing.
# The identity must come from a trusted authentication gateway; these settings
# do not implement login and do not make client-supplied identity headers safe.
SITE_OWNER_EMAIL=replace-with-your-verified-owner-email
SITE_OWNER_ID=replace-with-your-verified-owner-subject-id
# Public Cloudflare editor: a random 32+ character server-side bearer secret.
# Do not publish either value in GitHub, Expo or client-side JavaScript.
WORLD_EDITOR_TOKEN=replace-with-a-random-32-plus-character-secret
# Optional GitHub publishing: fine-grained PAT limited to
# matthewsmart212/humans-remain with Contents: Read and write.
# Configure as a Cloudflare Worker secret, not in a tracked .env file.
GITHUB_WORLD_SYNC_TOKEN=replace-with-a-server-only-github-token
#
# Required Worker bindings (provisioned services, not secret strings):
# DB       = D1-compatible SQLite database; schema is in drizzle/*.sql
# ARTWORK  = R2-compatible object bucket for uploaded images
# ASSETS   = static asset binding serving dist/client
#
# The offline local helper supplies its own synthetic example.test identity
# and filesystem/SQLite bindings, and needs no credentials or environment file.
# Native WORLD_URL is currently a source constant in native/config.ts.
