{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "humans-remain",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
